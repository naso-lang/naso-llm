# This container runs with NODE_ENV=production, and npm then omits every
# devDependency on a plain `npm install` -- including vite and typescript, so
# `npm install && npm run dev` fails. `include=dev` is the npm 11 override for
# exactly that: it forces devDeps to be installed regardless of NODE_ENV, so the
# standard workflow behaves as it does on a normal machine.
#
# (`omit=` is NOT the fix: npm rejects an empty value with
# "invalid config omit=""".)
include=dev

# Reproducible installs with the committed lockfile.
package-lock=true
