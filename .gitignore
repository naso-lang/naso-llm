# build output
dist/
node_modules/

# vite / editor
.vite/
*.local
.DS_Store

# the wasm-pack output is a build artefact of crates/nasoc-wasm; it is checked
# in only when it has been rebuilt from the pinned naso revision.
# public/pkg/*.wasm

# generated kernel artefacts (regenerate with `npm run compile:kernels`)
# public/kernels/*.wgsl
# public/kernels/*.abi.json

# model files are fetched at runtime and cached by the service worker
*.safetensors
*.npy
# pre-quantised checkpoint artefact: built locally (npm run quantize:build),
# ~163 MB, intentionally NOT committed. The app fetches it from /model/* at
# runtime when present, and falls back to the f32 safetensors otherwise.
*.npq
model.int8.npq
public/model/
# ... except the small committed reference data the checks compare against.
!tools/reference/*.npy
